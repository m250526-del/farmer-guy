# ============================================================
# KisaanDost / FarmAI — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is in .gitignore.
# ============================================================

# General
PROJECT_NAME=FarmAI          # Display name for the project
ENVIRONMENT=development      # "development" or "production"

# Primary Gemini key (text/reasoning default)
GEMINI_API_KEY=              # Your default Gemini API key

# Default model names (see AGENTS.md §4 for the fixed model list)
GEMINI_MODEL=gemini-3.5-flash-lite           # Primary text model override (default: gemini-3.5-flash-lite)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts   # Primary TTS model override (default: gemini-3.8-flash-lite-tts)

# Rotating chat keys (used in Stage 2 key-manager)
GEMINI_CHAT_KEY_1=           # Gemini API key slot 1 for chat
GEMINI_CHAT_KEY_2=           # Gemini API key slot 2 for chat
GEMINI_CHAT_KEY_3=           # Gemini API key slot 3 for chat

# Rotating STT keys
GEMINI_STT_KEY_1=            # Gemini API key slot 1 for STT
GEMINI_STT_KEY_2=            # Gemini API key slot 2 for STT
GEMINI_STT_KEY_3=            # Gemini API key slot 3 for STT

# Rotating TTS keys
GEMINI_TTS_KEY_1=            # Gemini API key slot 1 for TTS
GEMINI_TTS_KEY_2=            # Gemini API key slot 2 for TTS
GEMINI_TTS_KEY_3=            # Gemini API key slot 3 for TTS

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast   # Open-Meteo weather API base URL
N8N_WEBHOOK_BASE_URL=        # Base URL of your n8n instance, e.g. http://localhost:5678

# Gemini request behaviour (Stage 2)
GEMINI_REQUEST_TIMEOUT_SECONDS=30   # Seconds before a Gemini API call is aborted
KEY_COOLDOWN_SECONDS=60             # Seconds a rate-limited key is put on cooldown before retrying

# RAG & Knowledge (Stage 3)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001  # Gemini text embedding model
EMBEDDING_DIMENSIONS=768                     # Smaller vectors = less storage and faster search
CHROMA_PATH=data/chroma                      # ChromaDB storage path relative to backend/
RAG_TOP_K=3                                  # Default number of chunks to retrieve
RAG_CHUNK_MAX_CHARS=900                      # Maximum characters per knowledge chunk
RAG_CHUNK_OVERLAP_CHARS=100                  # Character overlap between adjacent chunks
RAG_MIN_RELEVANCE=0.0                        # Minimum similarity score (0.0 to 1.0; 0 disables filter)
RAG_CONTEXT_MAX_CHARS=3000                   # Hard limit on total context characters injected into prompts
RAG_QUERY_CACHE_SIZE=256                     # In-memory LRU cache size for query embeddings

